+/*
+ * Test device: a vendor interface carries enough class-specific padding to
+ * put the mass-storage interface past 4096 bytes.  A host that only reads
+ * one page of the configuration descriptor cannot find the disk.
+ */
+#define BIGCFG_PAD_COUNT 20
+#define BIGCFG_PAD_LEN   250
+
+static const uint8_t bigcfg_pad_data[BIGCFG_PAD_LEN] = {
+    BIGCFG_PAD_LEN, 0xff,
+    'X', 'E', 'N', 'E', 'V', 'A', ' ', 'B', 'I', 'G', ' ',
+    'C', 'O', 'N', 'F', 'I', 'G', ' ', 'P', 'A', 'D', 'D', 'I', 'N', 'G',
+};
+
+static USBDescOther bigcfg_pad_descs[] = {
+    [0 ... BIGCFG_PAD_COUNT - 1] = {
+        .length = BIGCFG_PAD_LEN,
+        .data = bigcfg_pad_data,
+    },
+};
+
+#define BIGCFG_PAD_IFACE { \
+    .bInterfaceNumber = 0, \
+    .bNumEndpoints = 0, \
+    .bInterfaceClass = 0xff, \
+    .ndesc = BIGCFG_PAD_COUNT, \
+    .descs = bigcfg_pad_descs, \
+}
+
+#define BIGCFG_MSC_IFACE(_mps, _burst) { \
+    .bInterfaceNumber = 1, \
+    .bNumEndpoints = 2, \
+    .bInterfaceClass = USB_CLASS_MASS_STORAGE, \
+    .bInterfaceSubClass = 0x06, \
+    .bInterfaceProtocol = 0x50, \
+    .eps = (USBDescEndpoint[]) { \
+        { \
+            .bEndpointAddress = USB_DIR_IN | 0x01, \
+            .bmAttributes = USB_ENDPOINT_XFER_BULK, \
+            .wMaxPacketSize = (_mps), \
+            .bMaxBurst = (_burst), \
+        }, { \
+            .bEndpointAddress = USB_DIR_OUT | 0x02, \
+            .bmAttributes = USB_ENDPOINT_XFER_BULK, \
+            .wMaxPacketSize = (_mps), \
+            .bMaxBurst = (_burst), \
+        }, \
+    }, \
+}
+
+static const USBDescIface bigcfg_iface_full[] = {
+    BIGCFG_PAD_IFACE,
+    BIGCFG_MSC_IFACE(64, 0),
+};
+
+static const USBDescIface bigcfg_iface_high[] = {
+    BIGCFG_PAD_IFACE,
+    BIGCFG_MSC_IFACE(512, 0),
+};
+
+static const USBDescIface bigcfg_iface_super[] = {
